ROOMFINDER_DEBUG=True
SECRET_KEY=replace-with-a-random-local-secret
# Optional for a custom backend domain; Railway domains are detected automatically.
# ROOMFINDER_ALLOWED_HOSTS=api.example.com
# Add the web frontend origin if it is hosted separately.
# ROOMFINDER_CORS_ORIGINS=https://app.example.com
# ROOMFINDER_MEDIA_ROOT=/app/media
DB_NAME=roomfinder_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
# Set DATABASE_URL to your Neon PostgreSQL connection string to use Neon.
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-sender@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=your-sender@gmail.com
ROOMFINDER_PUBLIC_URL=http://localhost:5173
