            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Create promotion (owner)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/promotions/",
            "description": "Create promotion (owner)",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"hotel\": \"{{hotel_id}}\",\n  \"code\": \"WELCOME15\",\n  \"percent\": 15,\n  \"starts_on\": \"2026-10-16\",\n  \"ends_on\": \"2027-10-16\",\n  \"active\": true\n}"
